{
  "appId": "com.tradermind.app",
  "productName": "TraderMind OS",
  "copyright": "Copyright © 2025 TraderMind",
  "directories": {
    "output": "dist-electron",
    "buildResources": "public"
  },
  "files": [
    "dist/public/**/*",
    "electron/dist/**/*",
    "public/icon.png",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/dist/main.js",
    "type": "commonjs"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.png",
    "artifactName": "TraderMind-Setup-${version}.exe",
    "requestedExecutionLevel": "user"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TraderMind OS",
    "unicode": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  }
}
